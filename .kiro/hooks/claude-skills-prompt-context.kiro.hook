{
  "name": "Claude Skills — prompt context watch",
  "description": "Managed by Claude Skills Manager (claude-skills-prompt-context)",
  "version": "1",
  "enabled": true,
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:49673/hook/prompt-context?agent=kiro&cwd=c%3A%5CUsers%5CFENIL%20LIMBACHIYA%5CDownloads%5Cfenil%20digital%20marketing%20wedding%20web\" || true",
    "timeout": 8
  }
}
